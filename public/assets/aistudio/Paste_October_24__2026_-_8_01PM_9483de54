<script>
  (function () {
    // Interactive Water Unit Tracker
    const waterButtons = document.querySelectorAll('.water-unit');
    const waterLoggedText = document.getElementById('water-logged-text');
    let filledUnits = 7; // initial 7 out of 10 (1.75 ~ 1.8L)

    function updateWaterDisplay() {
      waterButtons.forEach((btn, idx) => {
        if (idx < filledUnits) {
          btn.className = "water-unit h-9 rounded-md bg-secondary text-on-secondary flex flex-col items-center justify-center transition-all duration-200 active:scale-95 shadow-[0_0_8px_rgba(76,215,246,0.4)]";
          btn.innerHTML = '<span class="material-symbols-outlined text-[13px]">check</span>';
        } else {
          btn.className = "water-unit h-9 rounded-md bg-surface-container-high text-on-surface-variant/40 flex flex-col items-center justify-center transition-all duration-200 active:scale-95 hover:bg-secondary/40 hover:text-white";
          btn.innerHTML = '<span class="material-symbols-outlined text-[13px]">add</span>';
        }
      });
      const liters = (filledUnits * 0.25).toFixed(1);
      if (waterLoggedText) {
        waterLoggedText.textContent = liters + 'L of 2.5L Target';
      }
    }

    waterButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        if (index === filledUnits - 1) {
          filledUnits = Math.max(0, filledUnits - 1);
        } else {
          filledUnits = index + 1;
        }
        updateWaterDisplay();
      });
    });

    // Chart Switcher: Weight vs BMI Trajectory
    const btnWeight = document.getElementById('btn-toggle-weight');
    const btnBmi = document.getElementById('btn-toggle-bmi');
    const title = document.getElementById('trajectory-title');
    const subtitle = document.getElementById('trajectory-sub');
    const chartLine = document.getElementById('chart-line');
    const chartArea = document.getElementById('chart-area');

    if (btnWeight && btnBmi) {
      btnWeight.addEventListener('click', () => {
        btnWeight.className = "px-2.5 py-1 rounded font-label-data-sm text-label-data-sm font-semibold bg-surface-container-high text-on-surface shadow-sm transition-all";
        btnBmi.className = "px-2.5 py-1 rounded font-label-data-sm text-label-data-sm font-semibold text-on-surface-variant hover:text-on-surface transition-all";
        title.textContent = "Weight Trajectory";
        subtitle.textContent = "Current: 74.2 kg \u2022 Goal: 72.0 kg";
        chartLine.setAttribute('d', 'M 0,25 Q 40,28 75,32 T 150,42 T 225,50 T 300,58');
        chartArea.setAttribute('d', 'M 0,25 Q 40,28 75,32 T 150,42 T 225,50 T 300,58 L 300,80 L 0,80 Z');
      });

      btnBmi.addEventListener('click', () => {
        btnBmi.className = "px-2.5 py-1 rounded font-label-data-sm text-label-data-sm font-semibold bg-surface-container-high text-on-surface shadow-sm transition-all";
        btnWeight.className = "px-2.5 py-1 rounded font-label-data-sm text-label-data-sm font-semibold text-on-surface-variant hover:text-on-surface transition-all";
        title.textContent = "BMI Index Trajectory";
        subtitle.textContent = "Current: 22.8 BMI \u2022 Athletic Normal";
        chartLine.setAttribute('d', 'M 0,20 Q 50,22 100,26 T 200,34 T 300,40');
        chartArea.setAttribute('d', 'M 0,20 Q 50,22 100,26 T 200,34 T 300,40 L 300,80 L 0,80 Z');
      });
    }

    // Quick Log Action Drawer Trigger
    const quickLogBtn = document.getElementById('quick-log-btn');
    const quickDrawer = document.getElementById('quick-log-drawer');
    const closeDrawerBtn = document.getElementById('close-drawer-btn');
    const confirmLogBtn = document.getElementById('confirm-log-btn');

    if (quickLogBtn && quickDrawer) {
      quickLogBtn.addEventListener('click', () => {
        quickDrawer.classList.toggle('hidden');
        if (!quickDrawer.classList.contains('hidden')) {
          quickDrawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    if (closeDrawerBtn && quickDrawer) {
      closeDrawerBtn.addEventListener('click', () => {
        quickDrawer.classList.add('hidden');
      });
    }

    if (confirmLogBtn && quickDrawer) {
      confirmLogBtn.addEventListener('click', () => {
        confirmLogBtn.textContent = 'Meal Successfully Synced!';
        setTimeout(() => {
          quickDrawer.classList.add('hidden');
          confirmLogBtn.textContent = 'Record to Fuel Log';
        }, 800);
      });
    }
  })();
