  function switchMode(mode) {
    const liveBtn = document.getElementById('mode-live');
    const uploadBtn = document.getElementById('mode-upload');
    const quickBtn = document.getElementById('mode-quick');
    const quickPresets = document.getElementById('quick-presets');
    const pills = [liveBtn, uploadBtn, quickBtn];

    pills.forEach(p => {
      p.className = 'mode-pill flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-full text-on-surface-variant hover:text-on-surface transition-all text-left';
    });

    if (mode === 'live') {
      liveBtn.className = 'mode-pill flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-full bg-primary-container text-white shadow-sm transition-all text-left';
      quickPresets.classList.add('hidden');
      loadMealPreset('chipotle');
    } else if (mode === 'upload') {
      uploadBtn.className = 'mode-pill flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-full bg-primary-container text-white shadow-sm transition-all text-left';
      quickPresets.classList.add('hidden');
      document.getElementById('file-uploader').click();
    } else if (mode === 'quick') {
      quickBtn.className = 'mode-pill flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-full bg-primary-container text-white shadow-sm transition-all text-left';
      quickPresets.classList.remove('hidden');
    }
  }

  function loadMealPreset(key) {
    const data = presets[key];
    if (!data) return;

    document.getElementById('meal-title').textContent = data.title;
    document.getElementById('scan-confidence-badge').textContent = data.confidence + ' MATCH';
    document.getElementById('meal-grade').textContent = data.grade;
    document.getElementById('macro-cals').innerHTML = data.cals + ' <span class="font-body-sm text-body-sm text-on-surface-variant font-normal">kcal</span>';
    document.getElementById('macro-protein').textContent = data.protein;
    document.getElementById('macro-carbs').textContent = data.carbs;
    document.getElementById('macro-fat').textContent = data.fat;
    document.getElementById('macro-fiber').textContent = data.fiber;
    document.getElementById('macro-sodium').textContent = data.sodium;
    document.getElementById('gemini-tip-text').textContent = data.tip;

    const img = document.getElementById('viewfinder-image');
    img.style.opacity = '0.4';
    img.setAttribute('data-alt', data.alt);
    setTimeout(() => {
      img.style.opacity = '1';
    }, 200);

    const presetButtons = document.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.classList.remove('bg-surface-container-high', 'text-on-surface');
      btn.classList.add('bg-surface-container', 'text-on-surface-variant');
    });
    if (event && event.currentTarget && event.currentTarget.classList.contains('preset-btn')) {
      event.currentTarget.classList.remove('bg-surface-container', 'text-on-surface-variant');
      event.currentTarget.classList.add('bg-surface-container-high', 'text-on-surface');
    }
  }

  function handleFileUpload(event) {
    const file = event.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = document.getElementById('viewfinder-image');
        img.src = e.target.result;
        img.removeAttribute('data-alt');
        document.getElementById('meal-title').textContent = "Uploaded Dish (" + file.name.slice(0, 15) + "...)";
        document.getElementById('scan-confidence-badge').textContent = "95.2% MATCH";
      };
      reader.readAsDataURL(file);
    }
  }

  function retakePhotoAction() {
    const scanLine = document.getElementById('scan-line');
    scanLine.classList.remove('animate-pulse');
    void scanLine.offsetWidth;
    scanLine.classList.add('animate-pulse');
    switchMode('live');
  }

  function saveMealAction() {
    const btn = document.getElementById('save-meal-btn');
    const originalContent = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[22px] animate-spin">sync</span><span>Logging to Journal...</span>';
    btn.classList.add('opacity-80');
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-[22px] text-white">check_circle</span><span>Logged Successfully!</span>';
      btn.classList.remove('opacity-80', 'bg-primary-container');
      btn.classList.add('bg-tertiary-container');
      setTimeout(() => {
        btn.innerHTML = originalContent;
        btn.classList.remove('bg-tertiary-container');
        btn.classList.add('bg-primary-container');
      }, 2500);
    }, 900);
  }
