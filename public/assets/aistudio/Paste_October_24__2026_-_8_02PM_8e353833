<script>
  (function () {
    // Rest Countdown Logic
    let totalSeconds = 75; // 01:15
    let isRunning = true;
    let soundEnabled = true;
    const countdownEl = document.getElementById('countdown-display');
    const soundToggle = document.getElementById('sound-toggle-btn');
    const soundIcon = document.getElementById('sound-icon');
    const pauseBtn = document.getElementById('pause-btn');
    const pauseIcon = document.getElementById('pause-icon');
    const pauseText = document.getElementById('pause-text');

    const updateTimerDisplay = () => {
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      countdownEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    };

    const playBeep = () => {
      if (!soundEnabled) return;
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, audioCtx.currentTime); // High pitch motivational blip
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.15);
      } catch (e) {
        // AudioContext not allowed or unsupported
      }
    };

    const timerInterval = setInterval(() => {
      if (isRunning && totalSeconds > 0) {
        totalSeconds--;
        updateTimerDisplay();
        if (totalSeconds <= 3 && totalSeconds > 0) {
          playBeep();
        } else if (totalSeconds === 0) {
          playBeep();
          countdownEl.classList.add('text-tertiary');
        }
      }
    }, 1000);

    // Audio cue toggle
    soundToggle.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      if (soundEnabled) {
        soundIcon.textContent = 'volume_up';
        soundIcon.classList.remove('text-on-surface-variant');
        soundIcon.classList.add('text-primary');
        soundToggle.querySelector('span:last-child').textContent = 'Beep ON';
      } else {
        soundIcon.textContent = 'volume_off';
        soundIcon.classList.remove('text-primary');
        soundIcon.classList.add('text-on-surface-variant');
        soundToggle.querySelector('span:last-child').textContent = 'Muted';
      }
    });

    // Pause/Resume Workout toggle
    pauseBtn.addEventListener('click', () => {
      isRunning = !isRunning;
      if (!isRunning) {
        pauseIcon.textContent = 'play_circle';
        pauseText.textContent = 'Resume';
        pauseBtn.classList.add('bg-primary-container/20', 'text-primary');
      } else {
        pauseIcon.textContent = 'pause_circle';
        pauseText.textContent = 'Pause';
        pauseBtn.classList.remove('bg-primary-container/20', 'text-primary');
      }
    });

    // Drawer Toggle for Log Set
    const logTriggerBtn = document.getElementById('log-trigger-btn');
    const logDrawer = document.getElementById('quick-log-drawer');
    const confirmLogBtn = document.getElementById('confirm-log-btn');

    logTriggerBtn.addEventListener('click', () => {
      if (logDrawer.classList.contains('hidden')) {
        logDrawer.classList.remove('hidden');
        logDrawer.classList.add('flex');
      } else {
        logDrawer.classList.add('hidden');
        logDrawer.classList.remove('flex');
      }
    });

    // Value increments/decrements
    const weightVal = document.getElementById('weight-val');
    const repsVal = document.getElementById('reps-val');

    document.getElementById('weight-plus').addEventListener('click', () => {
      weightVal.value = (parseFloat(weightVal.value) || 0) + 2;
    });
    document.getElementById('weight-minus').addEventListener('click', () => {
      const v = (parseFloat(weightVal.value) || 0) - 2;
      weightVal.value = Math.max(0, v);
    });
    document.getElementById('reps-plus').addEventListener('click', () => {
      repsVal.value = (parseInt(repsVal.value, 10) || 0) + 1;
    });
    document.getElementById('reps-minus').addEventListener('click', () => {
      const v = (parseInt(repsVal.value, 10) || 0) - 1;
      repsVal.value = Math.max(1, v);
    });

    // Set 4 Check-off delight interaction
    const set4Chip = document.getElementById('set-4-chip');
    confirmLogBtn.addEventListener('click', () => {
      // Complete current active set animation
      set4Chip.classList.remove('bg-primary-container', 'animate-pulse');
      set4Chip.classList.add('bg-tertiary-container/20', 'text-tertiary');
      set4Chip.innerHTML = `
        <span class="font-label-data-sm text-[10px] font-bold">SET 4</span>
        <span class="material-symbols-outlined text-[16px] text-tertiary font-bold" style="font-variation-settings: 'FILL' 1;">check_circle</span>
      `;
      // Reset timer
      totalSeconds = 90;
      updateTimerDisplay();
      logDrawer.classList.add('hidden');
      logDrawer.classList.remove('flex');
      playBeep();
    });

    // Next Exercise button feedback
    const nextExBtn = document.getElementById('next-ex-btn');
    nextExBtn.addEventListener('click', () => {
      totalSeconds = 60;
      updateTimerDisplay();
      nextExBtn.classList.add('scale-95');
      setTimeout(() => nextExBtn.classList.remove('scale-95'), 150);
    });
  })();
