<script>
  // Grocery Checklist Interactive Calculations
  function updateGroceryStats() {
    const items = document.querySelectorAll('.grocery-item');
    let totalChecked = 0;
    let sum = 0;

    items.forEach(item => {
      const parentLabel = item.closest('label');
      const titleSpan = parentLabel.querySelector('.grocery-title');
      const price = parseFloat(item.getAttribute('data-price') || 0);

      if (item.checked) {
        totalChecked++;
        titleSpan.classList.add('line-through', 'opacity-70');
      } else {
        titleSpan.classList.remove('line-through', 'opacity-70');
      }
      sum += price;
    });

    const totalCount = items.length;
    const progressPercent = Math.round((totalChecked / totalCount) * 100);

    const checkedCountEl = document.getElementById('checked-count');
    const progressBar = document.getElementById('cart-progress-bar');
    const estTotalEl = document.getElementById('est-total');

    if (checkedCountEl) checkedCountEl.textContent = totalChecked;
    if (progressBar) progressBar.style.width = progressPercent + '%';
    if (estTotalEl) estTotalEl.textContent = '$' + sum.toFixed(2);
  }

  // Toggle Batch Cooking Steps
  function toggleStep(el) {
    const icon = el.querySelector('.check-icon');
    const text = el.querySelector('.step-text');
    const isCompleted = text.classList.contains('line-through');

    if (isCompleted) {
      text.classList.remove('line-through', 'opacity-70');
      icon.classList.remove('bg-tertiary', 'text-on-tertiary');
      icon.classList.add('bg-surface-container-highest', 'text-transparent');
    } else {
      text.classList.add('line-through', 'opacity-70');
      icon.classList.remove('bg-surface-container-highest', 'text-transparent');
      icon.classList.add('bg-tertiary', 'text-on-tertiary');
    }
  }

  // Timer Micro Interaction
  let timerInterval = null;
  let remainingSeconds = 45 * 60;
  let isTimerRunning = false;

  function formatTime(sec) {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
  }

  function toggleTimer() {
    const timerLabel = document.getElementById('timer-label');
    const prepTimer = document.getElementById('prep-timer');
    if (!isTimerRunning) {
      isTimerRunning = true;
      if (timerLabel) timerLabel.textContent = 'Pause Timer';
      timerInterval = setInterval(() => {
        if (remainingSeconds > 0) {
          remainingSeconds--;
          if (prepTimer) prepTimer.textContent = formatTime(remainingSeconds);
        } else {
          clearInterval(timerInterval);
          isTimerRunning = false;
          if (timerLabel) timerLabel.textContent = 'Done!';
        }
      }, 1000);
    } else {
      isTimerRunning = false;
      clearInterval(timerInterval);
      if (timerLabel) timerLabel.textContent = 'Resume Timer';
    }
  }

  function resetTimer() {
    clearInterval(timerInterval);
    isTimerRunning = false;
    remainingSeconds = 45 * 60;
    const prepTimer = document.getElementById('prep-timer');
    const timerLabel = document.getElementById('timer-label');
    if (prepTimer) prepTimer.textContent = '45:00';
    if (timerLabel) timerLabel.textContent = 'Start Timer';
  }

  // Export Plan Delight Notification
  function triggerExportDelight(btn) {
    const originalText = btn.innerHTML;
    btn.innerHTML = `<span class="material-symbols-outlined text-[20px] animate-spin">refresh</span><span>Compiling NUTRIPULSE Layout...</span>`;
    btn.disabled = true;

    setTimeout(() => {
      btn.innerHTML = originalText;
      btn.disabled = false;
      const toast = document.getElementById('export-toast');
      if (toast) {
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
        toast.classList.add('opacity-100', 'translate-y-0');

        setTimeout(() => {
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
          toast.classList.remove('opacity-100', 'translate-y-0');
        }, 3200);
      }
    }, 700);
  }
